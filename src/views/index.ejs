<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof appTitle !== 'undefined' ? appTitle : (typeof pageTitle !== 'undefined' ? pageTitle : 'Editorial Personal — Estudio de Poemarios en Tinta') %></title>
  <link rel="stylesheet" href="/css/switch-lit-tokens.css">
  <link rel="stylesheet" href="/css/switch-lit-components.css">
  <link rel="stylesheet" href="/css/studio-editor.css">
</head>
<body>

  <!-- BARRA SUPERIOR EDITORIAL -->
  <header class="sl-topbar" role="banner">
    <div class="sl-topbar__inner">
      <div class="sl-brand-group">
        <button type="button" id="btnBrandHome" class="sl-brand" title="Volver a la Biblioteca de Libros">
          <img src="/img/editorial-personal-logo.png" alt="Logo Editorial Personal" class="sl-brand__logo" width="40" height="40">
          <span class="sl-brand__text">
            <span class="sl-brand__title">Editorial Personal</span>
            <span class="sl-brand__sub">Edición Artesanal en Tinta &amp; Papel</span>
          </span>
        </button>

        <div class="sl-book-indicator" title="Poemario activo en edición">
          <span class="sl-book-indicator__label">Libro:</span>
          <select id="activeBookSelect" class="sl-book-indicator__select" aria-label="Seleccionar poemario activo">
            <option value="">Cargando biblioteca...</option>
          </select>
        </div>

        <div id="saveStatusPill" class="sl-save-pill" role="status" aria-live="polite">
          <span class="sl-save-pill__dot" aria-hidden="true"></span>
          <span id="saveStatusText">GUARDADO EN DISCO</span>
        </div>
      </div>

      <nav class="sl-nav" aria-label="Navegación principal del estudio editorial">
        <button type="button" id="navTabLibrary" class="sl-nav-tab is-active" data-view="library">
          1. Biblioteca de Libros
        </button>
        <button type="button" id="navTabStudio" class="sl-nav-tab" data-view="studio">
          2. Estudio &amp; Páginas
        </button>
        <button type="button" id="btnOpenQuickPoem" class="sl-nav-cta">
          + Ingreso Rápido de Poema
        </button>
        <button type="button" id="btnOpenPaperScanner" class="sl-btn sl-btn--sm sl-btn--cornflower" title="Escanear carta o poema escrito en papel (reconoce texto y dibujos)">
          Escanear Carta
        </button>
        <button type="button" id="navTabFormats" class="sl-nav-tab" data-view="formats">
          3. Formato &amp; Pliegos
        </button>
        <a id="btnTopbarExportPressPdf" href="#" download class="sl-btn sl-btn--sm sl-btn--lime" title="Descargar PDF vectorial 1:1 del libro activo">
          ↓ PDF Imprenta 1:1
        </a>
      </nav>
    </div>
  </header>

  <!-- CONTENEDOR PRINCIPAL DE VISTAS -->
  <main class="sl-main">
    <div class="sl-shell">

      <!-- ==================================================================
           VISTA 1: BIBLIOTECA MULTI-PROYECTO (FASE 1)
           ================================================================== -->
      <section id="viewLibrary" class="sl-view" aria-labelledby="heroMainTitle">
        <div class="library-hero">
          <div>
            <span class="sl-eyebrow">Imprenta Poética Multi-Formato · 300 DPI · Blanco &amp; Negro</span>
            <h1 id="heroMainTitle" class="sl-hero-display">POEMARIOS EN TINTA SOBRE PAPEL CREMA</h1>
            <p class="library-hero__lead">
              Diseñá cuadernillos cosidos, mini-libros de bolsillo, fanzines de una sola hoja o ediciones a medida en milímetros, con grabados en tinta sugeridos por tus propios versos.
            </p>
          </div>

          <div class="library-hero__aside">
            <div class="sl-accent-card sl-accent-card--cornflower">
              <span class="sl-eyebrow">Colección Guardada en Disco JSON</span>
              <p id="librarySummaryText" style="margin: 6px 0 10px; font-size: 13px;">
                Tus libros se guardan automáticamente con escritura atómica local sin perder ningún verso.
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                <button type="button" id="btnOpenActiveInStudio" class="sl-btn sl-btn--primary">
                  Abrir Libro Activo en Estudio →
                </button>
                <button type="button" id="btnRestoreSeedBook" class="sl-btn">
                  Restaurar Ejemplo Inicial
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="library-workspace">
          <!-- Grilla de Libros Guardados -->
          <div>
            <div class="library-toolbar">
              <div>
                <h2 class="sl-section-heading">Tus Poemarios</h2>
                <p class="sl-muted" style="margin: 0;">Abrí cualquier edición en el Estudio, duplicala para probar otro formato o creá un proyecto nuevo.</p>
              </div>
              <span id="libraryCountBadge" class="sl-pill sl-pill--lime">1 libro</span>
            </div>

            <div id="booksGridContainer" class="library-books-grid" aria-live="polite">
              <!-- Tarjetas de libros renderizadas por app.js -->
            </div>
          </div>

          <!-- Formulario: Crear Nuevo Poemario -->
          <aside class="sl-card" aria-labelledby="newBookFormHeading">
            <span class="sl-eyebrow">Nueva Edición</span>
            <h2 id="newBookFormHeading" class="sl-section-heading" style="margin-top: 4px;">Crear Nuevo Poemario</h2>
            <p class="sl-muted" style="margin-bottom: 14px;">
              Elegí el papel de impresión y el formato físico cerrado. Podés cambiarlo en cualquier momento dentro del Estudio.
            </p>

            <form id="createBookForm" class="new-book-form">
              <div class="sl-field">
                <label class="sl-label" for="newBookTitle">Título del Poemario</label>
                <input id="newBookTitle" name="title" type="text" class="sl-input" placeholder="Ej. Cartas para después de la lluvia" required maxlength="120">
              </div>

              <div class="two-col-fields">
                <div class="sl-field">
                  <label class="sl-label" for="newBookAuthor">Autor / Firma</label>
                  <input id="newBookAuthor" name="author" type="text" class="sl-input" placeholder="Ej. Grego" maxlength="80">
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="newBookSubtitle">Subtítulo / Colección</label>
                  <input id="newBookSubtitle" name="subtitle" type="text" class="sl-input" placeholder="Ej. Edición artesanal" maxlength="120">
                </div>
              </div>

              <div class="two-col-fields">
                <div class="sl-field">
                  <label class="sl-label" for="newBookPaper">Tamaño de Hoja Madre</label>
                  <select id="newBookPaper" name="paperId" class="sl-select">
                    <option value="A4">Hoja A4 (210 × 297 mm)</option>
                    <option value="LETTER">Hoja Carta / Letter (215.9 × 279.4 mm)</option>
                    <option value="A3">Hoja A3 (297 × 420 mm)</option>
                  </select>
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="newBookPageCount">Páginas Iniciales</label>
                  <select id="newBookPageCount" name="pageCount" class="sl-select">
                    <option value="8" selected>8 páginas (Clásico)</option>
                    <option value="12">12 páginas</option>
                    <option value="16">16 páginas (Poemario amplio)</option>
                    <option value="24">24 páginas</option>
                  </select>
                </div>
              </div>

              <div class="sl-field">
                <label class="sl-label" for="newBookFormat">Formato Físico del Libro</label>
                <select id="newBookFormat" name="formatId" class="sl-select">
                  <option value="saddle_half">Cuadernillo 1/2 Hoja (Doblado al medio · Tipo A5)</option>
                  <option value="pocket_quarter">Mini-Libro Bolsillo 1/4 Hoja (Muy chico · Tipo A6)</option>
                  <option value="single_sheet_zine">Fanzine 1 Sola Hoja (8 págs con 1 corte central)</option>
                  <option value="custom_nup">Personalizado mm × mm (Medida exacta del usuario)</option>
                </select>
              </div>

              <div id="newBookCustomDimensionsWrap" class="custom-mm-row is-hidden">
                <div class="sl-field">
                  <label class="sl-label" for="newBookCustomWidth">Ancho Cerrado (mm)</label>
                  <input id="newBookCustomWidth" name="customWidthMm" type="number" min="45" max="400" step="0.5" value="105" class="sl-input">
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="newBookCustomHeight">Alto Cerrado (mm)</label>
                  <input id="newBookCustomHeight" name="customHeightMm" type="number" min="60" max="410" step="0.5" value="148" class="sl-input">
                </div>
              </div>

              <div id="newBookGeometryPreview" class="sl-card--paper" style="padding: 10px 12px; border: var(--border-ink); border-radius: var(--radius-buttons); font-size: 11.5px;">
                <!-- Resumen físico en vivo antes de crear -->
              </div>

              <button type="submit" id="btnSubmitCreateBook" class="sl-btn sl-btn--lime sl-btn--block" style="padding: 10px 14px; font-size: 13px;">
                + Crear Poemario y Abrir en Estudio
              </button>
            </form>
          </aside>
        </div>
      </section>

      <!-- ==================================================================
           VISTA 2: ESTUDIO EDITORIAL DE POEMAS + ARTE 300 DPI (FASES 2 Y 3)
           ================================================================== -->
      <section id="viewStudio" class="sl-view is-hidden" aria-label="Estudio Editorial de Poemas e Ilustraciones">
        <div class="studio-grid">

          <!-- COLUMNA IZQUIERDA: ESTRUCTURA, FORMATO, PLANTILLAS Y MEDIDAS RECOMENDADAS -->
          <aside class="studio-col" aria-label="Estructura, formato y tipografía">

            <!-- Tarjeta 1: Datos del Libro y Selector Rápido de Formato/Papel -->
            <div class="sl-card">
              <div class="studio-section-head">
                <span class="sl-eyebrow">1. Libro &amp; Formato Físico</span>
                <button type="button" id="btnQuickJumpFormats" class="sl-btn sl-btn--sm" title="Ver plano completo del pliego">
                  Ver Pliego →
                </button>
              </div>

              <div class="two-col-fields" style="margin-bottom: 8px;">
                <div class="sl-field">
                  <label class="sl-label" for="studioBookTitleInput">Título del Libro</label>
                  <input id="studioBookTitleInput" type="text" class="sl-input" maxlength="120">
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="studioBookAuthorInput">Autor / Firma</label>
                  <input id="studioBookAuthorInput" type="text" class="sl-input" maxlength="80">
                </div>
              </div>

              <div class="two-col-fields">
                <div class="sl-field">
                  <label class="sl-label" for="studioPaperSelect">Hoja Madre</label>
                  <select id="studioPaperSelect" class="sl-select">
                    <option value="A4">Hoja A4</option>
                    <option value="LETTER">Hoja Carta</option>
                    <option value="A3">Hoja A3</option>
                  </select>
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="studioFormatSelect">Formato Libro</label>
                  <select id="studioFormatSelect" class="sl-select">
                    <option value="saddle_half">Cuadernillo 1/2 (A5)</option>
                    <option value="pocket_quarter">Bolsillo 1/4 (A6)</option>
                    <option value="single_sheet_zine">Fanzine 1 Hoja</option>
                    <option value="custom_nup">Personalizado mm</option>
                  </select>
                </div>
              </div>

              <div id="studioCustomMmWrap" class="custom-mm-row is-hidden" style="margin-top: 8px;">
                <div class="sl-field">
                  <label class="sl-label" for="studioCustomWidthInput">Ancho (mm)</label>
                  <input id="studioCustomWidthInput" type="number" min="45" max="400" step="0.5" class="sl-input">
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="studioCustomHeightInput">Alto (mm)</label>
                  <input id="studioCustomHeightInput" type="number" min="60" max="410" step="0.5" class="sl-input">
                </div>
              </div>
            </div>

            <!-- Tarjeta 2: Grilla Dinámica de Páginas (1..N) y Múltiplo de Encuadernación -->
            <div class="sl-card">
              <div class="studio-section-head">
                <span class="sl-eyebrow">2. Páginas del Poemario</span>
                <span id="pagesCountBadge" class="sl-pill sl-pill--mist">8 págs.</span>
              </div>

              <div id="pagesMatrixContainer" class="pages-matrix" role="listbox" aria-label="Páginas del libro">
                <!-- Botones 1..N -->
              </div>

              <div class="sl-field" style="margin-top: 8px;">
                <label class="sl-label" for="pageRoleInput">Etiqueta / Rol de esta Página</label>
                <input id="pageRoleInput" type="text" class="sl-input" maxlength="90" placeholder="Ej. Página 3 (Poema de apertura)">
              </div>

              <div class="page-ops-bar">
                <button type="button" id="btnAddSinglePage" class="sl-btn sl-btn--sm sl-btn--lime">+ Página</button>
                <button type="button" id="btnAddSpreadPages" class="sl-btn sl-btn--sm">+ Pliego (+4)</button>
                <button type="button" id="btnMovePageUp" class="sl-btn sl-btn--sm" title="Mover página antes">↑ Subir</button>
                <button type="button" id="btnMovePageDown" class="sl-btn sl-btn--sm" title="Mover página después">↓ Bajar</button>
                <button type="button" id="btnDeletePage" class="sl-btn sl-btn--sm" title="Eliminar página actual">Eliminar</button>
              </div>

              <div id="bindingMultipleIndicator" class="binding-status-strip">
                <!-- Estado de múltiplo óptimo (4 u 8 págs) -->
              </div>
            </div>

            <!-- Tarjeta 3: 10 Plantillas Editoriales + 4 Tipografías + Firma -->
            <div class="sl-card">
              <div class="studio-section-head">
                <span class="sl-eyebrow">3. Plantilla &amp; Tipografía</span>
              </div>

              <div class="sl-field" style="margin-bottom: 10px;">
                <label class="sl-label" for="pageLayoutSelect">Diseño Editorial (10 Plantillas)</label>
                <select id="pageLayoutSelect" class="sl-select">
                  <!-- Opciones pobladas desde PAGE_LAYOUTS -->
                </select>
              </div>

              <div class="sl-field" style="margin-bottom: 10px;">
                <span class="sl-label">Voz Tipográfica del Poema</span>
                <div id="poemFontButtonsContainer" class="font-choice-grid">
                  <!-- 4 botones desde POEM_FONTS -->
                </div>
              </div>

              <div class="two-col-fields" style="margin-bottom: 8px;">
                <div class="sl-field">
                  <label class="sl-label" for="pageFontSizeSelect">Cuerpo de Letra</label>
                  <select id="pageFontSizeSelect" class="sl-select">
                    <!-- Opciones desde FONT_SIZES -->
                  </select>
                </div>
                <div class="sl-field">
                  <label class="sl-label" for="pageSignatureInput">Firma / Pie</label>
                  <input id="pageSignatureInput" type="text" class="sl-input" placeholder="Ej. - Grego">
                </div>
              </div>

              <div class="sl-field" style="margin-bottom: 8px;">
                <label class="sl-label" for="pageTitleQuickInput">Título en Página (Portada / Poema)</label>
                <input id="pageTitleQuickInput" type="text" class="sl-input" placeholder="Opcional en páginas interiores">
              </div>

              <label style="display: inline-flex; align-items: center; gap: 7px; font-size: 11.5px; cursor: pointer;">
                <input id="pageShowNumberCheckbox" type="checkbox">
                <span>Mostrar número de página al pie</span>
              </label>
            </div>

            <!-- Tarjeta 4 (DESTACADA SWITCH-LIT #bed4fb): Dimensiones Recomendadas de Imagen @ 300 DPI -->
            <div class="sl-accent-card sl-accent-card--cornflower" id="recommendedSpecsCard">
              <span class="sl-eyebrow">Dimensiones Recomendadas de Imagen</span>
              <h3 class="sl-card-heading" style="margin-top: 3px;" id="specSlotLabel">Hueco de Ilustración</h3>
              <p id="specPlacementHint" style="font-size: 11.5px; margin: 4px 0 0; line-height: 1.35;"></p>

              <div class="specs-kv-grid">
                <div class="specs-kv-box">
                  <span class="specs-kv-box__label">Página Cerrada</span>
                  <span class="specs-kv-box__val" id="specClosedPageMm">148.5 × 210 mm</span>
                </div>
                <div class="specs-kv-box">
                  <span class="specs-kv-box__label">Hueco Ilustración</span>
                  <span class="specs-kv-box__val" id="specSlotMm">48 × 58 mm</span>
                </div>
                <div class="specs-kv-box">
                  <span class="specs-kv-box__label">Óptimo a 300 DPI</span>
                  <span class="specs-kv-box__val" id="specSlotPxDpi">567 × 685 px</span>
                </div>
                <div class="specs-kv-box">
                  <span class="specs-kv-box__label">Proporción</span>
                  <span class="specs-kv-box__val" id="specAspectRatio">1 : 1.2 (Vertical)</span>
                </div>
                <div id="specSecondarySlotBox" class="specs-kv-box specs-kv-box--wide is-hidden">
                  <span class="specs-kv-box__label">Ornamento Secundario de esta Plantilla</span>
                  <span class="specs-kv-box__val" id="specSecondarySlotText">—</span>
                </div>
                <div class="specs-kv-box specs-kv-box--wide">
                  <span class="specs-kv-box__label">Capacidad Óptima de Versos</span>
                  <span class="specs-kv-box__val" id="specVerseCapacity">Máx. 19 líneas · 34 caract./línea</span>
                </div>
              </div>

              <!-- Alerta interactiva si el poema actual supera la capacidad -->
              <div id="studioOverflowAlert" class="poem-overflow-banner is-hidden" role="alert">
                <div id="studioOverflowMessage" style="font-weight: 600;"></div>
                <div class="poem-overflow-banner__actions">
                  <button type="button" id="btnAutoShrinkFont" class="sl-btn sl-btn--sm sl-btn--primary">
                    Ajustar Letra
                  </button>
                  <button type="button" id="btnSplitOverflowPages" class="sl-btn sl-btn--sm">
                    Dividir en 2 Páginas Enfrentadas
                  </button>
                </div>
              </div>
            </div>

          </aside>

          <!-- COLUMNA CENTRAL: LIENZO INTERACTIVO DE PÁGINA REAL -->
          <section class="studio-col" aria-label="Lienzo de página en proporción geométrica real">
            <div class="canvas-stage-card">
              <div class="canvas-topbar">
                <div>
                  <span id="canvasPageBadge" class="sl-eyebrow">Página 1 de 8</span>
                  <div id="canvasRoleSubtitle" style="font-size: 12px; color: var(--color-ink-muted);">Tapa del Libro</div>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <button type="button" id="btnPrevPage" class="sl-btn sl-btn--sm">← Página Anterior</button>
                  <button type="button" id="btnNextPage" class="sl-btn sl-btn--sm">Página Siguiente →</button>
                </div>
              </div>

              <div class="canvas-ruler-bar">
                <span id="canvasPhysicalReadout">148.5 × 210 mm · Cuadernillo 1/2 Hoja sobre A4</span>
                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                  <button type="button" id="btnStudioScanLetter" class="sl-btn sl-btn--sm sl-btn--cornflower" title="Fotografiar o subir una carta en papel para pasar texto y dibujos a esta hoja">
                    Escanear Carta en Papel
                  </button>
                  <button type="button" id="btnToggleCanvasScale" class="sl-btn sl-btn--sm" title="Alternar entre tamaño amplio de lectura o escala comparativa">
                    Vista: Lectura Cómoda
                  </button>
                </div>
              </div>

              <div class="canvas-desk">
                <div id="singlePageCanvasHost" style="width: 100%; display: flex; justify-content: center;">
                  <!-- Página interactiva renderizada por pageRenderer.js -->
                </div>
              </div>

              <p class="sl-muted" style="margin: 10px 0 0; font-size: 11.5px; text-align: center;">
                Hacé clic sobre el título, los versos o la firma para escribir. Arrastrá grabados o fotos sobre la hoja blanca para ubicarlos libremente.
              </p>
            </div>
          </section>

          <!-- COLUMNA DERECHA: MOTOR HÍBRIDO DE IMÁGENES RELACIONADAS AL POEMA -->
          <aside class="studio-col studio-col--art" aria-label="Estudio de ilustraciones y grabados en tinta">
            <div class="sl-card">
              <div class="studio-section-head">
                <div>
                  <span class="sl-eyebrow">Arte &amp; Grabado B&amp;N</span>
                  <h2 class="sl-card-heading" style="margin-top: 2px;">Ilustración para tu Poema</h2>
                </div>
              </div>

              <!-- 3 Pestañas Switch-Lit -->
              <div class="art-tabs" role="tablist" aria-label="Fuentes de ilustración">
                <button type="button" id="artTabSuggested" class="art-tab-btn is-active" role="tab" aria-selected="true" data-art-tab="suggested">
                  Sugeridas
                </button>
                <button type="button" id="artTabUpload" class="art-tab-btn" role="tab" aria-selected="false" data-art-tab="upload">
                  Subir 300 DPI
                </button>
                <button type="button" id="artTabOnline" class="art-tab-btn" role="tab" aria-selected="false" data-art-tab="online">
                  Online B&amp;N
                </button>
              </div>

              <!-- Selector de Hueco Principal vs Secundario (cuando la plantilla tiene 2 grabados) -->
              <div id="artSlotTargetWrap" class="art-slot-switcher is-hidden">
                <button type="button" id="btnTargetPrimarySlot" class="sl-btn sl-btn--sm sl-btn--primary">
                  Ilustración Principal
                </button>
                <button type="button" id="btnTargetSecondarySlot" class="sl-btn sl-btn--sm">
                  Ornamento Secundario
                </button>
              </div>

              <!-- TAB A: SUGERIDAS POR TU POEMA (INSTANTÁNEO) + CATÁLOGO DE 40 GRABADOS -->
              <div id="artPanelSuggested" role="tabpanel">
                <div>
                  <span class="sl-label">Temas detectados en tus versos:</span>
                  <div id="detectedThemesContainer" class="theme-tags-wrap">
                    <!-- Chips #edfe5e -->
                  </div>
                </div>

                <div id="poemLayoutSuggestionBox" class="sl-card--paper" style="padding: 8px 10px; border: var(--border-ink); border-radius: var(--radius-buttons); margin-bottom: 12px; font-size: 11px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                  <span id="poemLayoutSuggestionText">Plantilla sugerida para este poema</span>
                  <button type="button" id="btnApplySuggestedLayout" class="sl-btn sl-btn--sm sl-btn--lime">Aplicar</button>
                </div>

                <div class="studio-section-head" style="margin-bottom: 6px;">
                  <span class="sl-label">6 Grabados Recomendados (1 clic o arrastrar)</span>
                </div>
                <div id="suggestedIllustrationsGrid" class="art-grid" style="max-height: 290px; margin-bottom: 14px;">
                  <!-- 6 sugerencias temáticas -->
                </div>

                <hr class="sl-divider">

                <div class="studio-section-head" style="margin-bottom: 8px;">
                  <span class="sl-label">Catálogo Completo (40 Grabados)</span>
                </div>
                <div class="two-col-fields" style="margin-bottom: 8px;">
                  <select id="catalogCategoryFilter" class="sl-select" aria-label="Filtrar catálogo por categoría">
                    <option value="all">Todas las categorías (40)</option>
                  </select>
                  <input id="catalogSearchInput" type="search" class="sl-input" placeholder="Buscar símbolo..." aria-label="Buscar grabado en catálogo">
                </div>
                <div id="fullCatalogGrid" class="art-grid" style="max-height: 280px;">
                  <!-- 40 ilustraciones SVG en tinta -->
                </div>
              </div>

              <!-- TAB B: SUBIR FOTO / DIBUJO Y CONVERTIR A GRABADO B&N (SHARP 300 DPI) -->
              <div id="artPanelUpload" class="is-hidden" role="tabpanel">
                <div id="uploadTargetSpecsBanner" class="sl-accent-card sl-accent-card--lime" style="padding: 9px 11px; margin-bottom: 12px; font-size: 11.5px;">
